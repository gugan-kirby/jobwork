{
  "name": "jobwork",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @jobwork/database migrate",
    "seed": "pnpm --filter @jobwork/database seed:dev",
    "stack:up": "bash infra/stack.sh up",
    "stack:down": "bash infra/stack.sh down",
    "stack:status": "bash infra/stack.sh status",
    "stack:observability": "bash infra/stack.sh observability",
    "stack:observability:down": "bash infra/stack.sh observability-down"
  },
  "devDependencies": {
    "@jobwork/config": "workspace:*",
    "eslint": "^9.30.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "argon2",
      "esbuild",
      "sharp"
    ]
  }
}

# Local development defaults. Copy to .env and adjust. Never put real secrets here (DO-15).
NODE_ENV=development
LOG_LEVEL=info

API_PORT=4000
API_URL=http://localhost:4000

DATABASE_URL=postgres://localhost:5432/jobwork_dev
# Supabase: use the Session pooler string, not the Data API URL, and verify its certificate:
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/supabase-ca.crt
# The shared limit is the project's pool size (15 by default), so the API and the worker
# must stay under it together. The API defaults to 10 and the worker to 5: set 8 and 4.
# DATABASE_POOL_MAX=8
REDIS_URL=redis://localhost:6379
# Rate limits (F-11.2): enforce | observe (log only) | off. Budgets per operation class
# can be replaced with a JSON document in RATE_LIMIT_POLICIES (see rate-limit/policies.ts).
RATE_LIMIT_MODE=enforce
# Workers (ADR-0009) have no Redis or native modules: count rate limits in Postgres and hash
# passwords with bcrypt inside Postgres. The defaults are redis and argon2id.
# RATE_LIMIT_STORE=postgres
# PASSWORD_HASHER=pgcrypto-bcrypt
# Proxy hops allowed to name the client address in X-Forwarded-For: loopback or an
# address/CIDR list (never a hop count or true). The web apps' rewrite proxy is a loopback
# hop locally; deployed, name the edge and web-app hosts.
TRUST_PROXY=loopback
# Browser origins allowed to send state-changing requests, comma separated. Unset, only
# localhost is allowed, so every deployed environment must set it or all logins are refused.
# ALLOWED_ORIGINS=https://app.example.com,https://ops.example.com

# MinIO (IN-03). Values below match infra/docker-compose.yml; a Homebrew-installed
# MinIO uses minioadmin/minioadmin instead. `pnpm stack:up` creates both buckets.
# Both web apps read OBJECT_STORE_ENDPOINT too (proxy.ts, F-FE.6): browsers PUT uploads
# straight to it, so its origin goes into CSP connect-src. It must be the endpoint the
# API signs grants against, as a browser can reach it.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=jobwork-dev
OBJECT_STORE_SECRET_KEY=jobwork-dev-secret
OBJECT_STORE_BUCKET_QUARANTINE=jobwork-quarantine
OBJECT_STORE_BUCKET_CLEAN=jobwork-clean
OBJECT_STORE_REGION=us-east-1
# Upload and download grants are short-lived capabilities (doc 03 §6).
UPLOAD_GRANT_TTL_SECONDS=900
DOWNLOAD_GRANT_TTL_SECONDS=120

# Mail: log:// writes outbound mail to var/mail as JSON (dev). smtp://user:pass@host:587 uses
# STARTTLS, smtps://user:pass@host:465 uses TLS; URL-encode @ in the user as %40. An SMTP URL
# needs SMTP_FROM. A production worker refuses log://.
SMTP_URL=log://
SMTP_FROM=

SESSION_COOKIE_NAME=jw_session
SESSION_SECRET=dev-only-change-me

# Internal service-to-service credentials (doc 20 §9). The worker mints short-lived
# tokens with this secret; deployed environments replace it with workload identity.
SERVICE_TOKEN_SECRET=dev-service-token-secret
API_URL=http://localhost:4000
# Scan worker limits (doc 11 §8).
SCAN_MAX_INSPECT_BYTES=268435456
SCAN_TIMEOUT_MS=30000

{
  "name": "@jobwork/database",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli.ts up",
    "migrate:status": "tsx src/cli.ts status",
    "seed:dev": "tsx seeds/dev-seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "argon2": "^0.41.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobwork-operations",
  // Built by `opennextjs-cloudflare build` first; see worker.mjs.
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The public address: https://jobwork-operations.<account subdomain>.workers.dev
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "API", "service": "jobwork-api" },
    // OpenNext's own binding back to this Worker.
    { "binding": "WORKER_SELF_REFERENCE", "service": "jobwork-operations" }
  ],
  "vars": {
    "NODE_ENV": "production"
    // OBJECT_STORE_ENDPOINT (the Supabase Storage S3 endpoint, for the upload CSP) is set in F-CW.7.
  }
}
